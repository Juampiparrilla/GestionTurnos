# Copiar este archivo a .env.local y completar con los valores reales.
# .env.local nunca se commitea (ver .gitignore).

# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: SOLO se usa server-side (invitar usuarios, etc.).
# NUNCA debe tener el prefijo NEXT_PUBLIC_ ni exponerse al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (envío de reportes por email) - resend.com
RESEND_API_KEY=
